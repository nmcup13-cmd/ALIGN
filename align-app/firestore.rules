rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // กฎเดียว: ต้องล็อกอิน (Firebase Auth) ก่อนเท่านั้น จึงจะอ่าน/เขียนได้
    // ไม่ตรวจ account_status/role ที่ชั้นนี้ — การบังคับใช้กฎทางธุรกิจหลัก (#1/#3/#5/#6)
    // ยังคงอยู่ที่ Next.js Server Action/API Route (Firebase Admin SDK) เป็นหลักเสมอ
    // ตามที่ align-tech-stack.md §2.2 ระบุไว้ — rule นี้เป็นแค่ defense-in-depth ชั้นที่สอง
    match /{document=**} {
      allow read, write: if request.auth != null;
    }
  }
}
